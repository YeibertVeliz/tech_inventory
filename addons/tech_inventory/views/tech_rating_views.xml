<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tech_rating_list" model="ir.ui.view">
        <field name="name">tech.rating.list</field>
        <field name="model">tech.rating</field>
        <field name="arch" type="xml">
            <list string="Valoraciones">
                <field name="name"/>
                <field name="equipment_id"/>
                <field name="evaluated_by_id"/>
                <field name="rating_date"/>
                <field name="rating" widget="badge"/>
                <field name="is_recommended" widget="boolean_toggle"/>
                <field name="active" invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_tech_rating_form" model="ir.ui.view">
        <field name="name">tech.rating.form</field>
        <field name="model">tech.rating</field>
        <field name="arch" type="xml">
            <form string="Valoración">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Referencia de la valoración..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="equipment_id"/>
                            <field name="rating_date"/>
                        </group>
                        <group>
                            <field name="evaluated_by_id"/>
                            <field name="rating"/>
                            <field name="is_recommended" readonly="1"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tech_rating_search" model="ir.ui.view">
        <field name="name">tech.rating.search</field>
        <field name="model">tech.rating</field>
        <field name="arch" type="xml">
            <search string="Buscar Valoraciones">
                <field name="equipment_id"/>
                <field name="evaluated_by_id"/>
                <filter name="recommended" string="Recomendados" domain="[('is_recommended', '=', True)]"/>
                <filter name="not_recommended" string="No Recomendados" domain="[('is_recommended', '=', False)]"/>
                <separator/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_by_equipment" string="Equipo" context="{'group_by': 'equipment_id'}"/>
                    <filter name="group_by_evaluator" string="Evaluador" context="{'group_by': 'evaluated_by_id'}"/>
                    <filter name="group_by_rating" string="Valoración" context="{'group_by': 'rating'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_tech_rating" model="ir.actions.act_window">
        <field name="name">Valoraciones</field>
        <field name="res_model">tech.rating</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_tech_rating_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                ¡Registra tu primera valoración!
            </p>
        </field>
    </record>
</odoo>
